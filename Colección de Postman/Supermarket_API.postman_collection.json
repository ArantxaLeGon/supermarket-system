          "// Genera datos únicos para que la colección se pueda ejecutar varias veces sin choques",
          "const r = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 10)).join('');",
          "pm.collectionVariables.set('rnd', r(6));",
          "pm.collectionVariables.set('rnd2', r(6));",
          "pm.collectionVariables.set('barcode1', '770' + r(10));",
          "pm.collectionVariables.set('barcode2', '770' + r(10));",
          "pm.collectionVariables.set('barcodeUpd', '770' + r(10));",
          "pm.collectionVariables.set('document', r(10));",
          "pm.collectionVariables.set('documentUpd', r(10));",
          "pm.collectionVariables.set('phone', '3' + r(9));"
        ]
      }
    }
